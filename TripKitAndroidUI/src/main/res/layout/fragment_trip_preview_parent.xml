<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.skedgo.tripkit.ui.trippreview.v2.TripPreviewParentViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".trippreview.v2.TripPreviewParentFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:appBackground="@{@color/colorPrimaryDark}"
            tools:background="@color/colorPrimaryDark"
            android:padding="@dimen/spacing_small">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Title in middle zone; padding set in code so it wraps between back and secondary -->
                <TextView
                    android:id="@+id/toolbarTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/font_size_medium"
                    android:text="@{viewModel.toolbarState.title}"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:breakStrategy="balanced"
                    android:clickable="false"
                    android:focusable="false"
                    tools:text="Add Booking Details" />

                <!-- Row on top so back/secondary stay clickable -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:id="@+id/layoutBack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:minWidth="48dp"
                        android:minHeight="48dp">

                        <ImageView
                            android:id="@+id/ivBack"
                            android:layout_width="@dimen/icon_regular"
                            android:layout_height="@dimen/icon_regular"
                            android:src="@drawable/ic_back_button"
                            android:padding="@dimen/spacing_extra_small"
                            app:appForeground="@{@color/colorAccent}"
                            android:visibility="@{viewModel.toolbarState.showBackButton}"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvBackAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/font_size_medium"
                            android:padding="@dimen/spacing_small"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@{viewModel.toolbarState.backActionLabel}"
                            app:appForeground="@{@color/colorAccent}"
                            tools:textColor="@color/colorAccent"
                            tools:text="Cancel" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvSecondaryAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/font_size_medium"
                        android:padding="@dimen/spacing_small"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@{viewModel.toolbarState.secondaryActionLabel}"
                        android:visibility="@{viewModel.toolbarState.showSecondaryAction}"
                        tools:text="Action"
                        app:appForeground="@{@color/colorAccent}"
                        tools:textColor="@color/colorAccent" />
                </LinearLayout>
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/toolbar"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>