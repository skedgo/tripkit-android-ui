<com.google.android.material.button.MaterialButton xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/button_size_48"
    android:layout_height="@dimen/button_size_48"
    android:layout_gravity="top|end"
    android:layout_margin="@dimen/spacing_normal"
    app:backgroundTint="@color/white"
    app:iconTint="@color/black"
    style="@style/Widget.MaterialComponents.Button.Icon"
    app:icon="@drawable/ic_profile_round"
    app:iconSize="@dimen/icon_size_24"
    app:iconGravity="textStart"
    android:padding="0dp"
    app:iconPadding="0dp"
    android:insetLeft="0dp"
    android:insetTop="0dp"
    android:insetRight="0dp"
    android:insetBottom="0dp"
    app:shapeAppearanceOverlay="@style/CircularMaterialButton" />
