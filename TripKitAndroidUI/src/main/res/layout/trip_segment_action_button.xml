<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="listener"
            type="com.skedgo.tripkit.ui.tripresult.ActionButtonClickListener" />

        <variable
            name="viewModel"
            type="com.skedgo.tripkit.ui.tripresult.ActionButtonViewModel" />
    </data>

    <androidx.compose.ui.platform.ComposeView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:abListener="@{listener}"
        app:abViewModel="@{viewModel}"
        app:abTitle="@{viewModel.title}"
        app:abIcon="@{viewModel.icon}"
        app:abShowSpinner="@{viewModel.showSpinner}"
        app:abBackground="@{viewModel.background}"
        tools:ignore="MissingConstraints" />

</layout>