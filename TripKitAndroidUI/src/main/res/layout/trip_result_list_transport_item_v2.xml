    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.skedgo.tripkit.ui.tripresults.TripResultTransportItemViewModel" />
    </data>

    <androidx.compose.ui.platform.ComposeView
