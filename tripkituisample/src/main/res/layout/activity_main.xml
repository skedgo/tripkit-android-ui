<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="@dimen/spacing_large"
        tools:context=".MainActivity">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_features"
            android:textSize="16sp"
            android:textColor="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/bAutocompleter"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/colorPrimary"
            android:text="@string/feature_autocompleter"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/bLocationSearch"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/colorPrimary"
            android:text="@string/lbl_location_search"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@+id/bAutocompleter" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/bMap"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/colorPrimary"
            android:text="@string/lbl_tripkit_map"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@+id/bLocationSearch" />

        <RadioGroup
            android:id="@+id/appearanceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/bMap"
            app:layout_constraintBottom_toBottomOf="parent">
            <RadioButton android:id="@+id/appearanceSystem" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/appearance_system" />
            <RadioButton android:id="@+id/appearanceLight" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/appearance_light" />
            <RadioButton android:id="@+id/appearanceDark" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/appearance_dark" />
        </RadioGroup>
    </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>